generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  EBAY
  POSHMARK
  MERCARI
  DEPOP
}

enum SaleStatus {
  NEW
  MATCHED
  PICKED
  PACKED
  SHIPPED
  CANCELLED
}

model BulkBuy {
  id            Int        @id @default(autoincrement())
  name          String
  purchaseDate  DateTime
  totalCost     Float
  purchasedQty  Int
  unlistedQty   Int
  notes         String?
  items         InventoryItem[]
  createdAt     DateTime   @default(now())
}

model InventoryItem {
  id            Int        @id @default(autoincrement())
  sku           String     @unique
  title         String
  quantity      Int        @default(1)
  unlisted      Boolean    @default(false)
  cogs          Float?
  condition     String?
  location      String?
  bulkBuyId     Int?
  bulkBuy       BulkBuy?   @relation(fields: [bulkBuyId], references: [id])
  listings      Listing[]
  saleLines     SaleLine[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Listing {
  id            Int        @id @default(autoincrement())
  platform      Platform
  externalId    String
  title         String
  quantity      Int        @default(1)
  active        Boolean    @default(true)
  inventoryItemId Int?
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  updatedAt     DateTime   @updatedAt

  @@unique([platform, externalId])
}

model Sale {
  id            Int        @id @default(autoincrement())
  platform      Platform
  externalOrderId String?
  externalListingId String?
  ingestionKey  String?    @unique
  matchMethod   String?
  matchConfidence Float?
  buyerUsername String?
  saleAmount    Float
  fees          Float      @default(0)
  shippingCost  Float      @default(0)
  status        SaleStatus @default(NEW)
  sourceEmailId String?
  soldAt        DateTime   @default(now())
  lines         SaleLine[]
  shippingLabel ShippingLabel?
  createdAt     DateTime   @default(now())
}

model SaleLine {
  id            Int       @id @default(autoincrement())
  saleId        Int
  inventoryItemId Int?
  title         String
  quantity      Int       @default(1)
  unitPrice     Float
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

model ShippingLabel {
  id            Int      @id @default(autoincrement())
  saleId        Int?     @unique
  source        String   @default("INDIVIDUAL")
  fileName      String   @default("")
  filePath      String?
  trackingNumber String?
  skuPrinted    String?
  buyerPrinted  String?
  status        String   @default("UNMATCHED")
  sale          Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model EmailMessage {
  id          Int      @id @default(autoincrement())
  provider    String   @default("gmail")
  messageId   String   @unique
  threadId    String?
  sender      String?
  subject     String?
  receivedAt  DateTime?
  snippet     String?
  bodyText    String?
  marketplace Platform?
  parsed      Boolean  @default(false)
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

model SyncRun {
  id          Int      @id @default(autoincrement())
  source      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String
  itemsFound  Int      @default(0)
  message     String?
}

model ConnectedAccount {
  id             Int      @id @default(autoincrement())
  provider       String   @unique
  email          String?
  accessTokenEnc String?
  refreshTokenEnc String?
  tokenExpiresAt DateTime?
  scopes         String?
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
